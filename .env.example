# Copia este archivo a `.env` (no se versiona) y ajusta los valores.

# --- Desarrollo web (npm start) ---
# Backend al que ng serve reenvía /api. Se lee al arrancar: reinicia ng serve si lo cambias.
BACKEND_URL=http://127.0.0.1:3000
# Pon false si el backend usa HTTPS con certificado autofirmado.
BACKEND_SEGURO=true

# --- APK móvil (npm run movil:apk) ---
# URL absoluta del backend, terminada en /api/v1.
# Emulador Android: http://10.0.2.2:3000/api/v1
API_MOVIL=http://10.0.2.2:3000/api/v1

# --- Docker / producción (se pasa al contenedor, no al build) ---
# BACKEND_UPSTREAM=backend-api:3000
